# ─────────────────────────────────────────────────────────────
# Nutrition AI Assistant — environment configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Security ────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — the app refuses to boot without this, and rejects this exact
# placeholder. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24

# ── Database ────────────────────────────────────────────────
DB_PATH=users.db

# ── LLM Provider (central switch) ───────────────────────────
# Controls ALL LLM components: agent, RAGs, intent parser, safety filter.
# Allowed values: "openai", "groq", "ollama"
LLM_PROVIDER=ollama

# ── Model per provider ──────────────────────────────────────
# Only the model matching LLM_PROVIDER above is actually used.
LLM_MODEL_OPENAI=gpt-4.1-mini
LLM_MODEL_GROQ=llama-3.3-70b-versatile
# Must be a tag you have actually pulled — the Ollama HTTP API does not
# auto-pull, so a bare "llama3.2" against a host holding only "llama3.2:3b"
# 404s every request. `ollama pull qwen3:4b` is the better agent model.
LLM_MODEL_OLLAMA=llama3.2:3b

# ── API Keys ────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# ── Ollama connection (only needed when LLM_PROVIDER=ollama) ─
OLLAMA_BASE_URL=http://localhost:11434/

# ── Embeddings (always local HuggingFace, not affected by LLM_PROVIDER) ─
# Shared by both RAGs. Switching models auto-rebuilds the FAISS indices on the
# next startup (dimension-mismatch detection), so no manual cleanup is needed.
#   BAAI/bge-m3                              - strong, multilingual (default, ~2GB)
#   BAAI/bge-base-en-v1.5                    - lighter English option (~440MB)
#   sentence-transformers/all-mpnet-base-v2  - previous default
EMBEDDING_MODEL=BAAI/bge-m3

# ── RAG retrieval quality ───────────────────────────────────
# Hybrid search (dense FAISS + sparse BM25, fused with RRF) and a cross-encoder
# reranker. Both default ON and degrade gracefully if a model is unavailable.
RAG_USE_HYBRID=true
RAG_USE_RERANKER=true
# Reranker model. Small/fast default; for higher quality use BAAI/bge-reranker-v2-m3
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_FETCH_K=30          # candidates retrieved before reranking
RAG_RERANK_TOP_N=8      # docs kept after reranking (medical RAG)

# ── Ingredient Detector ─────────────────────────────────────
# hybrid  the VLM proposes ingredients, YOLO independently confirms and
#         scores them. If either backend fails the other answers alone.
# vlm     VLM only (open vocabulary, no calibrated confidence)
# yolo    YOLO only (real confidence, fixed vocabulary)
DETECTOR_BACKEND=hybrid

# Ollama vision model. Needs `ollama pull qwen2.5vl:7b` (6.0 GB).
# "llava" still works but is a Jan-2024 model and noticeably weaker at
# enumerating ingredients on a cluttered plate.
DETECTOR_VLM_MODEL=qwen2.5vl:7b

# Layers to force onto the GPU for the VLM. 0 = let Ollama decide.
# Set 99 (= all) if Ollama rejects the model with "requires more system
# memory" even though the GPU has room — its estimate for multimodal models
# is conservative and counts system RAM it does not end up needing.
DETECTOR_VLM_NUM_GPU=0

# YOLO weights, auto-downloaded on first use.
#   yoloe-11s-seg-pf.pt  open vocabulary, 4585 classes (~200 foods) — default
#   yolo11n.pt           COCO, 80 classes, only 10 of them food
#   models/…/best.pt     your own fine-tune, see training/README.md
YOLO_WEIGHTS=yoloe-11s-seg-pf.pt
YOLO_CONFIDENCE=0.25
YOLO_DEVICE=cpu

# Legacy alias for DETECTOR_VLM_MODEL; leave empty.
CNN_MODEL_PATH=
CNN_CLASS_LABELS_PATH=
