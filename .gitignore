# ── Editors / OS ──
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*.bak
*.orig
*.rej
*.sublime-workspace
*.sublime-project

# ── Secrets ──
# .env, .env.local, .env.production, … — but keep the checked-in template.
.env*
!.env.example

# ── Python ──
.python-version
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
*.manifest
*.spec
*.log
*.tmp

# Virtualenvs
.venv/
venv/

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.coverage
.coverage.*
.cache/
.ipynb_checkpoints/

# ── ML artifacts ──
# Model weights and training output are distributed via GitHub Releases,
# not git. See training/README.md.
*.pt
*.pth
*.onnx
runs/
datasets/

# ── Project data ──
*.db
*.db-journal
*.sqlite3
/data_test
vector_databases/
requirements-dev.txt

# Uploaded images — keep the folder (via .gitkeep) but not the files
uploads/*
!uploads/.gitkeep

# ── Claude ──
.claude/
.claude_history/

# ── Flutter / Dart ──
# Per-platform generated files are handled by the nested .gitignore files
# under app/nutrition_ai_assistent/{android,ios,linux,macos,windows}/.
# Do NOT ignore linux/flutter/, windows/flutter/ or macos/Flutter/ wholesale:
# those directories contain CMakeLists.txt and other build inputs that must
# be committed. pubspec.lock is committed too — this is an app, not a package.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.dart.js
*.js_
*.js.deps
*.js.map
*.g.dart
*.freezed.dart
*.mocks.dart

# Flutter generated plugin registrants
**/flutter/generated_plugin_registrant.*
**/flutter/generated_plugins.cmake
**/flutter/GeneratedPluginRegistrant.*
**/Flutter/GeneratedPluginRegistrant.*

# Android (Flutter)
**/android/.gradle
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS/macOS (Flutter)
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/project.xcworkspace/
**/ios/**/xcuserdata/
**/ios/.generated/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/ephemeral/

# Web (Flutter)
**/web/dart/
**/web/packages/

# Windows/Linux (Flutter)
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
